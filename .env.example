# Copy this file to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-for-anything-but-your-laptop
# Leave DATABASE_URL unset to use SQLite (db.sqlite3) locally, or point at PostgreSQL:
# DATABASE_URL=postgres://bbms:bbms@localhost:5432/bbms
ALLOWED_HOSTS=localhost,127.0.0.1
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Encrypts proofs of identity (spec 03 §3.1). Optional when DEBUG=True (a key is worked out from SECRET_KEY);
# required in production. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ID_DOCUMENT_KEYS=
# GoCardless (Direct Debit, spec 04 §4.2). Leave unset locally to use the built-in fake (/dev/gocardless/).
# GOCARDLESS_ACCESS_TOKEN=sandbox_...
# GOCARDLESS_ENVIRONMENT=sandbox
# GOCARDLESS_WEBHOOK_SECRET=
# Stripe (card payments, spec 04 §4.3). Leave unset locally to use the built-in fake (/dev/stripe/).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
