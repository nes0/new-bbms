# Copy this file to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-for-anything-but-your-laptop
# Leave DATABASE_URL unset to use SQLite (db.sqlite3) locally, or point at PostgreSQL:
# DATABASE_URL=postgres://bbms:bbms@localhost:5432/bbms
ALLOWED_HOSTS=localhost,127.0.0.1
# Email (spec 06 §6.6). Leave EMAIL_HOST unset and emails are printed to the console. In production set it, with the
# SMTP login from your email provider (port 587 with STARTTLS unless you change these):
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=BBMS <noreply@bbms.buildbrighton.com>
# Encrypts proofs of identity (spec 03 §3.1). Optional when DEBUG=True (a key is worked out from SECRET_KEY);
# required in production. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ID_DOCUMENT_KEYS=
# Member photos go in a private DigitalOcean Spaces bucket in production (spec 01 §1.8). Leave SPACES_BUCKET empty to
# keep files in ./media when developing.
# SPACES_BUCKET=
# SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
# SPACES_REGION=lon1
# SPACES_KEY=
# SPACES_SECRET=
# GoCardless (Direct Debit, spec 04 §4.2). Leave unset locally to use the built-in fake (/dev/gocardless/).
# GOCARDLESS_ACCESS_TOKEN=sandbox_...
# GOCARDLESS_ENVIRONMENT=sandbox
# GOCARDLESS_WEBHOOK_SECRET=
# Heartbeats for the nightly billing jobs (spec 01 §1.8), e.g. Healthchecks.io ping URLs. Leave unset locally.
# HEARTBEAT_CREATE_CHARGES=https://hc-ping.com/...
# HEARTBEAT_BILL_MEMBERS=
# HEARTBEAT_CHECK_MEMBERSHIPS=
# HEARTBEAT_RETRY_DIRECT_DEBITS=
# Stripe (card payments, spec 04 §4.3). Leave unset locally to use the built-in fake (/dev/stripe/).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PayPal (spec 04 §4.4). The space's PayPal account; old accounts are only listed while members move off them.
# PAYPAL_ACCOUNT_EMAIL=
# PAYPAL_OLD_ACCOUNT_EMAILS=old-account@example.com
# PAYPAL_SANDBOX=True
# Moodle (spec 06 §6.12). Its address is an admin setting (Settings → Moodle). MOODLE_TOKEN lets BBMS ask whether a
# member has finished a course. OIDC_RSA_PRIVATE_KEY signs "Log in with BBMS" (a PEM key, line breaks written as \n);
# make one with: openssl genrsa 3072. Leave both unset locally: a fake Moodle is used and the provider is off.
# MOODLE_TOKEN=
# OIDC_RSA_PRIVATE_KEY=
# Discord (spec 06 §6.14). Leave unset locally to use the built-in fake (/dev/discord/).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_MEMBER_ROLE_ID=
# DISCORD_FORMER_MEMBER_ROLE_ID=
# DISCORD_WELCOME_CHANNEL_ID=
# DISCORD_ANNOUNCEMENT_CHANNEL_ID=  # new proposals and their results are announced here
# Logging in (spec 06 §6.11): the proxy header with the visitor's IP address, for rate limits per visitor.
# Leave unset locally. On DigitalOcean App Platform: HTTP_DO_CONNECTING_IP
# CLIENT_IP_HEADER=
